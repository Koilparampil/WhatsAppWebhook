[Unit]
Description=WhatsApp to email forwarder (webhook + queue worker)
Documentation=https://github.com/Koilparampil/WhatsAppWebhook
After=network-online.target
Wants=network-online.target
# safety net: stop restarting after 5 failed starts within 5 minutes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=whwebhook
Group=whwebhook
WorkingDirectory=/opt/whatsapp-webhook
EnvironmentFile=/etc/whatsapp-webhook/env
ExecStart=/opt/whatsapp-webhook/.venv/bin/python -m app.cli run
Restart=always
RestartSec=3
# exit code 78 (EX_CONFIG) means the env file is invalid: restarting cannot help until it is fixed
RestartPreventExitStatus=78
# Give the worker time to finish an in-flight email on stop (matches WORKER_SHUTDOWN_GRACE_SECONDS + margin).
TimeoutStopSec=40
KillSignal=SIGTERM

# Resource ceiling, measured while splitting and sending a 100 MB document:
#   Graph transport: ~170 MB at the default MAIL_MAX_MESSAGE_BYTES=32 MB, ~260 MB at 95 MB, ~480 MB at 150 MB
#   SMTP transport:  ~330 MB at 32 MB, ~450 MB at 95 MB, ~760 MB at 150 MB
# Idle the service uses 70 to 100 MB. 600M covers every Graph setting and SMTP up to about 95 MB.
MemoryMax=600M
TasksMax=128

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @raw-io @reboot @swap @module @obsolete
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/whatsapp-webhook
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
