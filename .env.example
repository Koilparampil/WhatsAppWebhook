# Configuration for the WhatsApp email forwarder.
# On the VM this lives at /etc/whatsapp-webhook/env (root:whwebhook, mode 640). Never commit real values.
# Replace every placeholder value before starting the service; install.sh lists any that remain.
# Format: KEY=value, one per line; quote values that contain spaces ("..."). Avoid "${" in secrets.

# ---------------------------------------------------------------- WhatsApp / Meta
# Any random string; paste the same value into Meta App Dashboard > WhatsApp > Configuration > Verify token.
WA_VERIFY_TOKEN=CHANGE_ME
# Meta App Dashboard > App settings > Basic > App secret. Used to validate X-Hub-Signature-256.
WA_APP_SECRET=CHANGE_ME
# Permanent System User access token (docs/setup-meta-whatsapp.md). Needed to download media (and, with
# RELAY_ENABLED=true, to send the WhatsApp updates and check their templates).
WA_ACCESS_TOKEN=CHANGE_ME
WA_GRAPH_API_VERSION=v27.0
# Optional: only forward messages sent to this business phone number id (leave empty for all).
WA_PHONE_NUMBER_ID=
# Optional: Messaging account id (WABA id) so `whatsapp-webhook meta-check` can list numbers and subscriptions.
# Required when RELAY_ENABLED=true (used to check that the update templates are approved).
WA_WABA_ID=
# Never set to true in production.
WA_ALLOW_UNSIGNED=false
# Optional, one-time: the /onboard page that connects a WhatsApp Business app number (Coexistence).
# Leave empty unless you are doing that onboarding (docs/setup-meta-whatsapp.md, section 5a), then clear
# ONBOARD_KEY again. WA_APP_ID: App Dashboard > App settings > Basic. ONBOARD_CONFIG_ID: Facebook Login for
# Business > Configurations. ONBOARD_KEY: any random string of 16+ characters (openssl rand -hex 16).
WA_APP_ID=
ONBOARD_CONFIG_ID=
ONBOARD_KEY=

# ---------------------------------------------------------------- VShipCRM
CRM_ENABLED=true
CRM_BASE_URL=https://vship2000-prod-api.azurewebsites.net
CRM_USERNAME=CHANGE_ME
CRM_PASSWORD=CHANGE_ME
# Lists to search, in priority order (Customer only, per project decision).
CRM_ENTITIES=Customer
# Region used to interpret CRM phone numbers that have no country code.
CRM_DEFAULT_REGION=US
# Reload the customer list every N seconds; a miss also triggers a reload when the index is older than
# CRM_MISS_REFRESH_MIN_AGE_SECONDS.
CRM_REFRESH_SECONDS=900
CRM_MISS_REFRESH_MIN_AGE_SECONDS=60
CRM_INCLUDE_INACTIVE=false
# Put every email of the matched customer in Reply-To (true) or only the first one (false).
CRM_REPLY_TO_ALL_EMAILS=true

# ---------------------------------------------------------------- Mail transport
# graph -> deliver through Microsoft Graph sendMail with an Entra app registration (chosen path)
# smtp  -> deliver over SMTP (Microsoft 365 SMTP AUTH with OAuth as the fallback, or any relay)
MAIL_TRANSPORT=graph

# SMTP settings are only used when MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (port 25 relay / Direct Send)
SMTP_SECURITY=starttls
# password (SMTP AUTH), oauth (SMTP AUTH with XOAUTH2 client credentials) or none (Direct Send / relay)
SMTP_AUTH=password
SMTP_USERNAME=
SMTP_PASSWORD=

# Microsoft Entra app registration (required for MAIL_TRANSPORT=graph and SMTP_AUTH=oauth)
# docs/setup-microsoft365-email.md section 2 explains where each value comes from.
OAUTH_TENANT_ID=CHANGE_ME
OAUTH_CLIENT_ID=CHANGE_ME
OAUTH_CLIENT_SECRET=CHANGE_ME
# Shared mailbox the Graph transport sends from (its primary SMTP address)
GRAPH_SENDER=whatsapp@vship2000.com

# ---------------------------------------------------------------- Mail content
# Fixed sender mailbox. The display name carries the WhatsApp sender's name via MAIL_FROM_NAME_TEMPLATE.
MAIL_FROM=whatsapp@vship2000.com
MAIL_FROM_NAME_TEMPLATE="{display_name} via WhatsApp"
# Comma-separated recipients inside your Microsoft 365 tenant.
MAIL_TO=CHANGE_ME
MAIL_SUBJECT_PREFIX=[WhatsApp]
# IANA timezone used for timestamps in the email body, e.g. America/New_York
MAIL_TIMEZONE=America/New_York
# Optional Reply-To used when the CRM lookup fails (leave empty to omit the header).
MAIL_FALLBACK_REPLY_TO=
# Largest encoded email the mail system accepts. Exchange Online's default send limit is 35 MB
# (36,700,160 bytes); 32,000,000 leaves headroom. Media above this is split across numbered emails.
# Raise only if the tenant's MaxSendSize/MaxReceiveSize were raised (docs/setup-microsoft365-email.md).
MAIL_MAX_MESSAGE_BYTES=32000000
MAIL_SPLIT_LARGE_MEDIA=true
# Send an alert email when a message lands in the dead-letter list.
ALERT_ON_DEAD_LETTER=true
# Alert recipients (defaults to MAIL_TO when empty).
ALERT_TO=

# ---------------------------------------------------------------- Worker / app
# Retry failed deliveries for this long after the first attempt, then dead-letter + alert.
WORKER_RETRY_WINDOW_SECONDS=600
WORKER_BASE_DELAY_SECONDS=15
WORKER_MAX_DELAY_SECONDS=120
# Alert emails keep retrying for this long (default 12 h) so a mail outage is still reported once it ends.
ALERT_RETRY_WINDOW_SECONDS=43200
# Keep processed queue rows (with the raw payload) for this many days.
STORE_RETENTION_DAYS=30
LOG_LEVEL=INFO
# Mask phone numbers in logs (+16*****1234).
LOG_MASK_PHONES=true
# Local paths (install.sh appends the production values).
STORE_PATH=./data/queue.db
SPOOL_DIR=./data/spool
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000

# ---------------------------------------------------------------- WhatsApp updates from email
# An employee on RELAY_ALLOWED_SENDERS emails the relay mailbox with the subject "WA | phone | booking" and
# the body Name: / Message: / the update / ##; the service sends the customer the approved WhatsApp template
# (docs/whatsapp-updates-setup.md). RELAY_ENABLED=true needs MAIL_TRANSPORT=graph and WA_ACCESS_TOKEN, and
# makes WA_WABA_ID (above) and RELAY_PHONE_NUMBER_ID (or WA_PHONE_NUMBER_ID) required.
# A mistake in a RELAY_* line never stops the service, not even a value that is not true/false or a number
# (RELAY_ENABLED=flase, RELAY_POLL_SECONDS=30s, a line left empty): only this feature stays off, and
# `whatsapp-webhook check-config` prints a WARNING naming the line (relay-check: a FAIL line).
# Switches the feature on. Emails that arrived before it was first switched on are never handled.
RELAY_ENABLED=false
# Mailbox whose Inbox is read for commands; empty = GRAPH_SENDER.
RELAY_MAILBOX=
# Business phone number id the updates are sent from; empty = WA_PHONE_NUMBER_ID. Use this one when
# WA_PHONE_NUMBER_ID is empty: setting WA_PHONE_NUMBER_ID would also filter which messages are forwarded.
RELAY_PHONE_NUMBER_ID=
# Comma-separated addresses allowed to send updates (any letter case; not the relay mailbox itself).
# Command emails from anyone else stay in the Inbox; ALERT_TO gets at most one notice per 24 hours about them.
RELAY_ALLOWED_SENDERS=
# Only act on emails Exchange marked as sent by a signed-in internal user (header
# X-MS-Exchange-Organization-AuthAs: Internal). Never set false without an Exchange lock-down.
RELAY_REQUIRE_INTERNAL_AUTH=true
# true = check every command and email the employee what would have been sent; nothing goes to WhatsApp.
RELAY_DRY_RUN=true
# Comma-separated phone numbers; when set, updates to any other number are refused (test mode).
# Go live with RELAY_DRY_RUN=false and RELAY_TEST_NUMBERS empty.
RELAY_TEST_NUMBERS=
# How often the Inbox is read, in seconds (at least 10).
RELAY_POLL_SECONDS=30
# Country assumed for 10-digit numbers (and 11 digits starting with 1); any other number needs + and the
# country code. Two upper-case letters.
RELAY_DEFAULT_REGION=US
# The approved UTILITY template sent for every update (WhatsApp Manager > Message templates).
RELAY_TEMPLATE_NAME=vship_update
# Language code of all relay templates, exactly as shown in WhatsApp Manager (e.g. en_US or en).
RELAY_TEMPLATE_LANGUAGE=en_US
# What fills {{1}}, {{2}}, ... of the update template, in order, from name, message and booking
# (name and message are required).
RELAY_TEMPLATE_PARAMS=name,message
# Optional template used when the subject has a booking number; empty = the update template is used and the
# booking number only appears in the confirmation email.
RELAY_BOOKING_TEMPLATE_NAME=
# Its variables in order; required when RELAY_BOOKING_TEMPLATE_NAME is set, and must hold name, message and
# booking.
RELAY_BOOKING_TEMPLATE_PARAMS=
# Optional template with a document header, used to send attached files when the customer's 24-hour window
# is closed; empty = such files are not sent (the confirmation email says so).
RELAY_DOCUMENT_TEMPLATE_NAME=
# Its body variables in order, from name, booking and filename (may be empty).
RELAY_DOCUMENT_TEMPLATE_PARAMS=
# How long a template's Approved / Utility status at Meta is trusted before it is checked again, in seconds
# (at least 60).
RELAY_TEMPLATE_CHECK_SECONDS=600
# Longest Message accepted, in characters after line breaks are joined (1 to 30000); longer is refused.
# 820 keeps the whole update (fixed text 138 + name up to 60 + message) within Meta's 1,024-character body limit.
RELAY_MAX_MESSAGE_CHARS=820
# Longest Name accepted, in characters (1 to 200); longer is refused.
RELAY_MAX_NAME_CHARS=60
# Greeting word used when the Name line is empty ("Hello there, ...").
RELAY_NAME_FALLBACK=there
# A command handled more than this many hours after it arrived is refused; the employee is asked to resend.
RELAY_MAX_AGE_HOURS=24
# Folder of the relay mailbox that handled commands are moved to (top level, created on first use).
RELAY_FOLDER="WhatsApp updates - handled"
