# Configuration for the WhatsApp email forwarder.
# On the VM this lives at /etc/whatsapp-webhook/env (root:whwebhook, mode 640). Never commit real values.
# Replace every placeholder value before starting the service; install.sh lists any that remain.
# Format: KEY=value, one per line; quote values that contain spaces ("..."). Avoid "${" in secrets.

# ---------------------------------------------------------------- WhatsApp / Meta
# Any random string; paste the same value into Meta App Dashboard > WhatsApp > Configuration > Verify token.
WA_VERIFY_TOKEN=CHANGE_ME
# Meta App Dashboard > App settings > Basic > App secret. Used to validate X-Hub-Signature-256.
WA_APP_SECRET=CHANGE_ME
# Permanent System User access token (docs/setup-meta-whatsapp.md). Needed to download media.
WA_ACCESS_TOKEN=CHANGE_ME
WA_GRAPH_API_VERSION=v27.0
# Optional: only forward messages sent to this business phone number id (leave empty for all).
WA_PHONE_NUMBER_ID=
# Optional: Messaging account id (WABA id) so `whatsapp-webhook meta-check` can list numbers and subscriptions.
WA_WABA_ID=
# Never set to true in production.
WA_ALLOW_UNSIGNED=false

# ---------------------------------------------------------------- VShipCRM
CRM_ENABLED=true
CRM_BASE_URL=https://vship2000-prod-api.azurewebsites.net
CRM_USERNAME=CHANGE_ME
CRM_PASSWORD=CHANGE_ME
# Lists to search, in priority order (Customer only, per project decision).
CRM_ENTITIES=Customer
# Region used to interpret CRM phone numbers that have no country code.
CRM_DEFAULT_REGION=US
# Reload the customer list every N seconds; a miss also triggers a reload when the index is older than
# CRM_MISS_REFRESH_MIN_AGE_SECONDS.
CRM_REFRESH_SECONDS=900
CRM_MISS_REFRESH_MIN_AGE_SECONDS=60
CRM_INCLUDE_INACTIVE=false
# Put every email of the matched customer in Reply-To (true) or only the first one (false).
CRM_REPLY_TO_ALL_EMAILS=true

# ---------------------------------------------------------------- Mail transport
# graph -> deliver through Microsoft Graph sendMail with an Entra app registration (chosen path)
# smtp  -> deliver over SMTP (Microsoft 365 SMTP AUTH with OAuth as the fallback, or any relay)
MAIL_TRANSPORT=graph

# SMTP settings are only used when MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (port 25 relay / Direct Send)
SMTP_SECURITY=starttls
# password (SMTP AUTH), oauth (SMTP AUTH with XOAUTH2 client credentials) or none (Direct Send / relay)
SMTP_AUTH=password
SMTP_USERNAME=
SMTP_PASSWORD=

# Microsoft Entra app registration (required for MAIL_TRANSPORT=graph and SMTP_AUTH=oauth)
# docs/setup-microsoft365-email.md section 2 explains where each value comes from.
OAUTH_TENANT_ID=CHANGE_ME
OAUTH_CLIENT_ID=CHANGE_ME
OAUTH_CLIENT_SECRET=CHANGE_ME
# Shared mailbox the Graph transport sends from (its primary SMTP address)
GRAPH_SENDER=whatsapp@vship2000.com

# ---------------------------------------------------------------- Mail content
# Fixed sender mailbox. The display name carries the WhatsApp sender's name via MAIL_FROM_NAME_TEMPLATE.
MAIL_FROM=whatsapp@vship2000.com
MAIL_FROM_NAME_TEMPLATE="{display_name} via WhatsApp"
# Comma-separated recipients inside your Microsoft 365 tenant.
MAIL_TO=CHANGE_ME
MAIL_SUBJECT_PREFIX=[WhatsApp]
# IANA timezone used for timestamps in the email body, e.g. America/New_York
MAIL_TIMEZONE=America/New_York
# Optional Reply-To used when the CRM lookup fails (leave empty to omit the header).
MAIL_FALLBACK_REPLY_TO=
# Largest encoded email the mail system accepts. Exchange Online's default send limit is 35 MB
# (36,700,160 bytes); 32,000,000 leaves headroom. Media above this is split across numbered emails.
# Raise only if the tenant's MaxSendSize/MaxReceiveSize were raised (docs/setup-microsoft365-email.md).
MAIL_MAX_MESSAGE_BYTES=32000000
MAIL_SPLIT_LARGE_MEDIA=true
# Send an alert email when a message lands in the dead-letter list.
ALERT_ON_DEAD_LETTER=true
# Alert recipients (defaults to MAIL_TO when empty).
ALERT_TO=

# ---------------------------------------------------------------- Worker / app
# Retry failed deliveries for this long after the first attempt, then dead-letter + alert.
WORKER_RETRY_WINDOW_SECONDS=600
WORKER_BASE_DELAY_SECONDS=15
WORKER_MAX_DELAY_SECONDS=120
# Alert emails keep retrying for this long (default 12 h) so a mail outage is still reported once it ends.
ALERT_RETRY_WINDOW_SECONDS=43200
# Keep processed queue rows (with the raw payload) for this many days.
STORE_RETENTION_DAYS=30
LOG_LEVEL=INFO
# Mask phone numbers in logs (+16*****1234).
LOG_MASK_PHONES=true
# Local paths (install.sh appends the production values).
STORE_PATH=./data/queue.db
SPOOL_DIR=./data/spool
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
